[run]
# Include branch coverage
branch = True

# Only include specific files that we have tests for
source = .
include =
    backend/__init__.py
    backend/ingest_spool.py

# Omit everything else
omit =
    backend/hexnil_fastapi_server.py
    backend/hexnil_ai_pipeline.py
    test_*.py
    **/test_*.py
    tests/*
    conftest.py
    analyze_*.py
    check_*.py
    apply_*.py
    snapshot_*.py
    inspect_*.py
    query_*.py
    run_*.py
    smoke_test_pipeline.py
    setup_database.py
    hexnil_auto_sync.py
    .venv/*
    venv/*
    build/*
    __pycache__/*
    .pytest_cache/*

[report]
# Exclude lines from coverage
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    logger\.
    logging\.

# Fail if coverage is below threshold
fail_under = 100

# Show missing lines in output
show_missing = True

# Precision for coverage percentage
precision = 2

[html]
directory = htmlcov

[xml]
output = coverage.xml
