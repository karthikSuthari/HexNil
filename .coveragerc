[run]
# Include branch coverage
branch = True

# Measure coverage for the backend package
source = backend

# Omit files without tests
omit =
    backend/hexnil_fastapi_server.py
    backend/hexnil_ai_pipeline.py

[report]
# Exclude lines from coverage
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    logger\.
    logging\.

# Fail if coverage is below threshold
fail_under = 100

# Show missing lines in output
show_missing = True

# Precision for coverage percentage
precision = 2

[html]
directory = htmlcov

[xml]
output = coverage.xml
