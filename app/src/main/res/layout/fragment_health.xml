<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oem_bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/oem_padding_medium">

        <!-- Status Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            style="@style/Widget.HexNil.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/oem_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BATTERY HEALTH STATUS"
                    android:textAppearance="@style/TextAppearance_HexNil_Headline3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/oem_divider_height"
                    android:layout_marginTop="@dimen/oem_margin_medium"
                    android:layout_marginBottom="@dimen/oem_margin_medium"
                    android:background="@color/oem_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HEALTH"
                            android:textAppearance="@style/TextAppearance_HexNil_Label" />

                        <TextView
                            android:id="@+id/tv_health_percentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/oem_padding_tiny"
                            android:text="--%"
                            android:textAppearance="@style/TextAppearance_HexNil_Metric"
                            android:textSize="32sp"
                            tools:text="94%" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CYCLE COUNT"
                            android:textAppearance="@style/TextAppearance_HexNil_Label" />

                        <TextView
                            android:id="@+id/tv_cycle_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/oem_padding_tiny"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance_HexNil_Metric"
                            android:textSize="32sp"
                            tools:text="150" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Health Trend Graph Card (Swipeable) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            style="@style/Widget.HexNil.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/oem_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="HEALTH TREND"
                        android:textAppearance="@style/TextAppearance_HexNil_Headline3" />

                    <TextView
                        android:id="@+id/tv_health_trend_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STABLE"
                        android:textAppearance="@style/TextAppearance_HexNil_Label"
                        android:textColor="@color/oem_status_safe" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/oem_padding_tiny"
                    android:text="Swipe to navigate time"
                    android:textAppearance="@style/TextAppearance_HexNil_Caption"
                    android:textColor="@color/oem_text_tertiary" />

                <!-- Health % Line Chart -->
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_health_trend"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="@dimen/oem_margin_small" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Capacity Trend Graph Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            style="@style/Widget.HexNil.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/oem_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAPACITY TREND"
                    android:textAppearance="@style/TextAppearance_HexNil_Headline3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/oem_padding_tiny"
                    android:text="Estimated capacity over time (mAh)"
                    android:textAppearance="@style/TextAppearance_HexNil_Caption"
                    android:textColor="@color/oem_text_tertiary" />

                <!-- Capacity Line Chart -->
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_capacity_trend"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginTop="@dimen/oem_margin_small" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Key Metrics Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            style="@style/Widget.HexNil.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/oem_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KEY METRICS"
                    android:textAppearance="@style/TextAppearance_HexNil_Headline3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/oem_divider_height"
                    android:layout_marginTop="@dimen/oem_margin_medium"
                    android:layout_marginBottom="@dimen/oem_margin_medium"
                    android:background="@color/oem_divider" />

                <!-- Capacity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/oem_margin_medium"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Design Capacity"
                        android:textAppearance="@style/TextAppearance_HexNil_Body" />

                    <TextView
                        android:id="@+id/tv_design_capacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- mAh"
                        android:textAppearance="@style/TextAppearance_HexNil_Body"
                        android:textStyle="bold"
                        tools:text="5000 mAh" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/oem_margin_medium"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Current Capacity"
                        android:textAppearance="@style/TextAppearance_HexNil_Body" />

                    <TextView
                        android:id="@+id/tv_current_capacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- mAh"
                        android:textAppearance="@style/TextAppearance_HexNil_Body"
                        android:textStyle="bold"
                        tools:text="4700 mAh" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/oem_margin_medium"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Capacity Fade"
                        android:textAppearance="@style/TextAppearance_HexNil_Body" />

                    <TextView
                        android:id="@+id/tv_capacity_fade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--%"
                        android:textAppearance="@style/TextAppearance_HexNil_Body"
                        android:textStyle="bold"
                        tools:text="6.0%" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Degradation Rate"
                        android:textAppearance="@style/TextAppearance_HexNil_Body" />

                    <TextView
                        android:id="@+id/tv_degradation_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--%/month"
                        android:textAppearance="@style/TextAppearance_HexNil_Body"
                        android:textStyle="bold"
                        tools:text="0.3%/month" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Health Assessment Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            style="@style/Widget.HexNil.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/oem_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ASSESSMENT"
                    android:textAppearance="@style/TextAppearance_HexNil_Headline3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/oem_divider_height"
                    android:layout_marginTop="@dimen/oem_margin_medium"
                    android:layout_marginBottom="@dimen/oem_margin_medium"
                    android:background="@color/oem_divider" />

                <TextView
                    android:id="@+id/tv_health_verdict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No data available"
                    android:textAppearance="@style/TextAppearance_HexNil_Body"
                    tools:text="Health status: Normal. Capacity fade within expected range." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
