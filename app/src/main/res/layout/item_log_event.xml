<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/oem_margin_small"
    style="@style/Widget.HexNil.Card"
    app:cardBackgroundColor="@color/oem_bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/oem_card_padding">

        <!-- Header Row: Severity Indicator + Title + Timestamp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Severity Indicator -->
            <View
                android:id="@+id/severity_indicator"
                android:layout_width="4dp"
                android:layout_height="32dp"
                android:background="@color/oem_status_safe"
                tools:background="@color/oem_status_warning" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/oem_margin_medium"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_event_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EVENT TYPE"
                    android:textAppearance="@style/TextAppearance_HexNil_Label"
                    tools:text="THERMAL_ALERT" />

                <TextView
                    android:id="@+id/tv_event_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Event Title"
                    android:textAppearance="@style/TextAppearance_HexNil_Headline3"
                    android:textSize="14sp"
                    tools:text="High Temperature Detected" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textAppearance="@style/TextAppearance_HexNil_Caption"
                android:textColor="@color/oem_text_tertiary"
                tools:text="14:32" />
        </LinearLayout>

        <!-- Description (Collapsed by default) -->
        <TextView
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/oem_margin_small"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Event description goes here..."
            android:textAppearance="@style/TextAppearance_HexNil_Body"
            android:textColor="@color/oem_text_secondary"
            tools:text="Battery temperature exceeded 42°C during charging session." />

        <!-- Expanded Details Section (Hidden by default) -->
        <LinearLayout
            android:id="@+id/details_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/oem_margin_medium"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/oem_divider_height"
                android:layout_marginBottom="@dimen/oem_margin_small"
                android:background="@color/oem_divider" />

            <TextView
                android:id="@+id/tv_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:text="Details..."
                android:textAppearance="@style/TextAppearance_HexNil_Monospace"
                android:textColor="@color/oem_text_secondary"
                android:textSize="12sp"
                tools:text="Trigger:     42.3°C\nThreshold:   40.0°C\nDeviation:   +5.75%\nDuration:    3m 42s\nCharging:    YES" />
        </LinearLayout>

        <!-- Expand/Collapse Indicator -->
        <ImageView
            android:id="@+id/iv_expand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/oem_margin_small"
            android:contentDescription="Expand details"
            android:src="@drawable/ic_expand_more"
            android:tint="@color/oem_text_tertiary"
            android:padding="4dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>