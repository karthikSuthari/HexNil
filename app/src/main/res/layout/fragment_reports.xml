<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/report_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reports"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />

        <TextView
            android:id="@+id/report_daily"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily: --"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

        <TextView
            android:id="@+id/report_weekly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weekly: --"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

        <TextView
            android:id="@+id/report_export_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Export: --"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

        <TextView
            android:id="@+id/chart_rollups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rollup chart data"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <TextView
            android:id="@+id/chart_thermal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thermal heat buckets"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <TextView
            android:id="@+id/chart_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="App drain ranking"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <TextView
            android:id="@+id/chart_charging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Charging curve"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <TextView
            android:id="@+id/chart_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update impact"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

    </LinearLayout>
</ScrollView>
