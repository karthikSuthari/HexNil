<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oem_bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/oem_padding_medium">

        <!-- Drain Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            style="@style/Widget.HexNil.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/oem_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DRAIN ANALYSIS"
                    android:textAppearance="@style/TextAppearance_HexNil_Headline3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/oem_divider_height"
                    android:layout_marginTop="@dimen/oem_margin_medium"
                    android:layout_marginBottom="@dimen/oem_margin_medium"
                    android:background="@color/oem_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SCREEN-ON DRAIN"
                            android:textAppearance="@style/TextAppearance_HexNil_Label" />

                        <TextView
                            android:id="@+id/tv_screen_on_drain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/oem_padding_tiny"
                            android:text="-- %/hr"
                            android:textAppearance="@style/TextAppearance_HexNil_Metric"
                            android:textSize="28sp"
                            tools:text="12.5 %/hr" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IDLE DRAIN"
                            android:textAppearance="@style/TextAppearance_HexNil_Label" />

                        <TextView
                            android:id="@+id/tv_idle_drain"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/oem_padding_tiny"
                            android:text="-- %/hr"
                            android:textAppearance="@style/TextAppearance_HexNil_Metric"
                            android:textSize="28sp"
                            tools:text="0.8 %/hr" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Key Metrics Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            style="@style/Widget.HexNil.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/oem_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KEY METRICS"
                    android:textAppearance="@style/TextAppearance_HexNil_Headline3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/oem_divider_height"
                    android:layout_marginTop="@dimen/oem_margin_medium"
                    android:layout_marginBottom="@dimen/oem_margin_medium"
                    android:background="@color/oem_divider" />

                <!-- Drain Events -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/oem_margin_medium"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Drain Events"
                        android:textAppearance="@style/TextAppearance_HexNil_Body" />

                    <TextView
                        android:id="@+id/tv_drain_events"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/TextAppearance_HexNil_Body"
                        android:textStyle="bold"
                        tools:text="45" />
                </LinearLayout>

                <!-- Average Drain Rate -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/oem_margin_medium"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Average Drain Rate"
                        android:textAppearance="@style/TextAppearance_HexNil_Body" />

                    <TextView
                        android:id="@+id/tv_avg_drain_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- %/hr"
                        android:textAppearance="@style/TextAppearance_HexNil_Body"
                        android:textStyle="bold"
                        tools:text="8.2 %/hr" />
                </LinearLayout>

                <!-- Primary Cause -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Primary Cause"
                        android:textAppearance="@style/TextAppearance_HexNil_Body" />

                    <TextView
                        android:id="@+id/tv_primary_cause"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/TextAppearance_HexNil_Body"
                        android:textStyle="bold"
                        tools:text="Display" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Assessment Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            style="@style/Widget.HexNil.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/oem_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ASSESSMENT"
                    android:textAppearance="@style/TextAppearance_HexNil_Headline3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/oem_divider_height"
                    android:layout_marginTop="@dimen/oem_margin_medium"
                    android:layout_marginBottom="@dimen/oem_margin_medium"
                    android:background="@color/oem_divider" />

                <TextView
                    android:id="@+id/tv_drain_assessment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No drain data available"
                    android:textAppearance="@style/TextAppearance_HexNil_Body"
                    tools:text="Drain behavior: Normal. Screen-on drain within expected range." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
