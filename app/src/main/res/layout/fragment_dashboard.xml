<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oem_bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/oem_padding_medium">

        <!-- System Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            style="@style/Widget.HexNil.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/oem_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/status_indicator"
                        android:layout_width="@dimen/oem_status_indicator_size"
                        android:layout_height="@dimen/oem_status_indicator_size"
                        android:background="@drawable/status_indicator_green" />

                    <TextView
                        android:id="@+id/tv_service_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/oem_margin_small"
                        android:layout_weight="1"
                        android:text="MONITORING ACTIVE"
                        android:textAppearance="@style/TextAppearance_HexNil_Headline3" />

                    <ImageButton
                        android:id="@+id/btn_refresh"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Refresh"
                        android:src="@drawable/ic_refresh"
                        app:tint="@color/oem_text_tertiary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_uptime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/oem_padding_tiny"
                    android:text="Uptime: --"
                    android:textAppearance="@style/TextAppearance_HexNil_Caption" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Primary Metrics Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            style="@style/Widget.HexNil.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/oem_padding_large">

                <!-- Battery Level -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_battery_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textAppearance="@style/TextAppearance_HexNil_Metric"
                        android:textSize="56sp"
                        tools:text="85" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/oem_padding_small"
                        android:text="BATTERY LEVEL"
                        android:textAppearance="@style/TextAppearance_HexNil_Label" />

                    <TextView
                        android:id="@+id/tv_charging_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/oem_margin_small"
                        android:text="DISCHARGING"
                        android:textAppearance="@style/TextAppearance_HexNil_Body"
                        tools:text="CHARGING" />

                    <ProgressBar
                        android:id="@+id/progress_battery"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="@dimen/oem_margin_medium"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/oem_accent" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Secondary Metrics Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            android:orientation="horizontal">

            <!-- Temperature -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/oem_margin_small"
                android:layout_weight="1"
                style="@style/Widget.HexNil.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/oem_card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TEMPERATURE"
                        android:textAppearance="@style/TextAppearance_HexNil_Label" />

                    <TextView
                        android:id="@+id/tv_temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/oem_padding_tiny"
                        android:text="--°C"
                        android:textAppearance="@style/TextAppearance_HexNil_Metric"
                        android:textSize="24sp"
                        tools:text="32.5°C" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Voltage -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/oem_margin_small"
                android:layout_weight="1"
                style="@style/Widget.HexNil.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/oem_card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VOLTAGE"
                        android:textAppearance="@style/TextAppearance_HexNil_Label" />

                    <TextView
                        android:id="@+id/tv_voltage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/oem_padding_tiny"
                        android:text="-- mV"
                        android:textAppearance="@style/TextAppearance_HexNil_Metric"
                        android:textSize="24sp"
                        tools:text="3950 mV" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Tertiary Metrics Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            android:orientation="horizontal">

            <!-- Current -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/oem_margin_small"
                android:layout_weight="1"
                style="@style/Widget.HexNil.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/oem_card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CURRENT"
                        android:textAppearance="@style/TextAppearance_HexNil_Label" />

                    <TextView
                        android:id="@+id/tv_current"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/oem_padding_tiny"
                        android:text="-- mA"
                        android:textAppearance="@style/TextAppearance_HexNil_Metric"
                        android:textSize="24sp"
                        tools:text="350 mA" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Health -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/oem_margin_small"
                android:layout_weight="1"
                style="@style/Widget.HexNil.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/oem_card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HEALTH"
                        android:textAppearance="@style/TextAppearance_HexNil_Label" />

                    <TextView
                        android:id="@+id/tv_health"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/oem_padding_tiny"
                        android:text="--%"
                        android:textAppearance="@style/TextAppearance_HexNil_Metric"
                        android:textSize="24sp"
                        tools:text="94%" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Remote Access Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_remote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            style="@style/Widget.HexNil.Card"
            app:cardBackgroundColor="@color/oem_bg_elevated">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/oem_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/remote_status_indicator"
                        android:layout_width="@dimen/oem_status_indicator_size"
                        android:layout_height="@dimen/oem_status_indicator_size"
                        android:background="@drawable/status_indicator_off" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/oem_margin_small"
                        android:layout_weight="1"
                        android:text="REMOTE ACCESS"
                        android:textAppearance="@style/TextAppearance_HexNil_Headline3" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_remote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_remote_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/oem_margin_small"
                    android:text="Enable to access from laptop"
                    android:textAppearance="@style/TextAppearance_HexNil_Monospace" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Database Statistics Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            style="@style/Widget.HexNil.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/oem_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DATABASE STATISTICS"
                    android:textAppearance="@style/TextAppearance_HexNil_Headline3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/oem_divider_height"
                    android:layout_marginTop="@dimen/oem_margin_medium"
                    android:layout_marginBottom="@dimen/oem_margin_medium"
                    android:background="@color/oem_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_snapshot_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance_HexNil_Metric"
                            android:textSize="20sp"
                            android:textColor="@color/oem_accent"
                            tools:text="12.5K" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/oem_padding_tiny"
                            android:text="Snapshots"
                            android:textAppearance="@style/TextAppearance_HexNil_Caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_session_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance_HexNil_Metric"
                            android:textSize="20sp"
                            android:textColor="@color/oem_accent"
                            tools:text="234" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/oem_padding_tiny"
                            android:text="Sessions"
                            android:textAppearance="@style/TextAppearance_HexNil_Caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_event_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance_HexNil_Metric"
                            android:textSize="20sp"
                            android:textColor="@color/oem_accent"
                            tools:text="89" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/oem_padding_tiny"
                            android:text="Events"
                            android:textAppearance="@style/TextAppearance_HexNil_Caption" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Active Monitors Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            style="@style/Widget.HexNil.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/oem_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE MONITORS"
                    android:textAppearance="@style/TextAppearance_HexNil_Headline3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/oem_divider_height"
                    android:layout_marginTop="@dimen/oem_margin_medium"
                    android:layout_marginBottom="@dimen/oem_margin_medium"
                    android:background="@color/oem_divider" />

                <TextView
                    android:id="@+id/tv_monitors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textAppearance="@style/TextAppearance_HexNil_Body"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/oem_margin_small"
            android:layout_marginBottom="@dimen/oem_margin_small"
            android:text="QUICK ACTIONS"
            android:textAppearance="@style/TextAppearance_HexNil_Label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_health"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/oem_padding_tiny"
                android:layout_weight="1"
                android:text="Health"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_idle"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/oem_padding_tiny"
                android:layout_marginEnd="@dimen/oem_padding_tiny"
                android:layout_weight="1"
                android:text="Idle"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_calibration"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/oem_padding_tiny"
                android:layout_weight="1"
                android:text="Calibration"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/oem_padding_tiny"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ai"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/oem_padding_tiny"
                android:layout_weight="1"
                android:text="AI Analysis"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reports"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/oem_padding_tiny"
                android:layout_marginEnd="@dimen/oem_padding_tiny"
                android:layout_weight="1"
                android:text="Reports"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_compliance"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/oem_padding_tiny"
                android:layout_weight="1"
                android:text="Compliance"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/oem_padding_tiny"
            android:layout_marginBottom="@dimen/oem_padding_large"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_device"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/oem_padding_tiny"
                android:layout_weight="1"
                android:text="Device"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_settings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/oem_padding_tiny"
                android:layout_weight="1"
                android:text="Settings"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
