<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oem_bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/oem_padding_medium">

        <!-- Executive Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            style="@style/Widget.HexNil.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/oem_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EXECUTIVE SUMMARY"
                    android:textAppearance="@style/TextAppearance_HexNil_Headline3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/oem_divider_height"
                    android:layout_marginTop="@dimen/oem_margin_medium"
                    android:layout_marginBottom="@dimen/oem_margin_medium"
                    android:background="@color/oem_divider" />

                <TextView
                    android:id="@+id/tv_executive_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No analysis data available"
                    android:textAppearance="@style/TextAppearance_HexNil_Body"
                    tools:text="Battery system operating within normal parameters. No critical issues detected." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Risk Assessment Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            style="@style/Widget.HexNil.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/oem_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RISK ASSESSMENT"
                    android:textAppearance="@style/TextAppearance_HexNil_Headline3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/oem_divider_height"
                    android:layout_marginTop="@dimen/oem_margin_medium"
                    android:layout_marginBottom="@dimen/oem_margin_medium"
                    android:background="@color/oem_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RISK SCORE"
                            android:textAppearance="@style/TextAppearance_HexNil_Label" />

                        <TextView
                            android:id="@+id/tv_risk_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/oem_padding_tiny"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance_HexNil_Metric"
                            android:textSize="32sp"
                            tools:text="15" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SEVERITY"
                            android:textAppearance="@style/TextAppearance_HexNil_Label" />

                        <TextView
                            android:id="@+id/tv_severity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/oem_padding_tiny"
                            android:text="--"
                            android:textAppearance="@style/TextAppearance_HexNil_Metric"
                            android:textSize="24sp"
                            tools:text="LOW" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Root Cause Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            style="@style/Widget.HexNil.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/oem_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ROOT CAUSE ANALYSIS"
                    android:textAppearance="@style/TextAppearance_HexNil_Headline3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/oem_divider_height"
                    android:layout_marginTop="@dimen/oem_margin_medium"
                    android:layout_marginBottom="@dimen/oem_margin_medium"
                    android:background="@color/oem_divider" />

                <TextView
                    android:id="@+id/tv_root_cause"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No issues detected"
                    android:textAppearance="@style/TextAppearance_HexNil_Body"
                    tools:text="Primary issue: None. Battery system operating normally." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recommendations Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            style="@style/Widget.HexNil.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/oem_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECOMMENDATIONS"
                    android:textAppearance="@style/TextAppearance_HexNil_Headline3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/oem_divider_height"
                    android:layout_marginTop="@dimen/oem_margin_medium"
                    android:layout_marginBottom="@dimen/oem_margin_medium"
                    android:background="@color/oem_divider" />

                <TextView
                    android:id="@+id/tv_recommendations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No recommendations at this time"
                    android:textAppearance="@style/TextAppearance_HexNil_Body"
                    tools:text="Continue monitoring. System operating within expected parameters." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Technical Details Card (Expandable) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oem_margin_medium"
            style="@style/Widget.HexNil.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/oem_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TECHNICAL DETAILS"
                    android:textAppearance="@style/TextAppearance_HexNil_Headline3" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/oem_divider_height"
                    android:layout_marginTop="@dimen/oem_margin_medium"
                    android:layout_marginBottom="@dimen/oem_margin_medium"
                    android:background="@color/oem_divider" />

                <TextView
                    android:id="@+id/tv_technical_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Analysis period: --\nData points analyzed: --\nConfidence: --"
                    android:textAppearance="@style/TextAppearance_HexNil_Caption"
                    android:fontFamily="monospace"
                    tools:text="Analysis period: Last 24 hours&#10;Data points analyzed: 1,234&#10;Confidence: 92%" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
