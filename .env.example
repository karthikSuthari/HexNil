# HexNil Backend Configuration
# Copy this to .env file and fill in your actual values

# ============================================================================
# MYSQL DATABASE CONFIGURATION
# ============================================================================

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=hexnil

# Backend service user (used by FastAPI for ingesting data)
MYSQL_BACKEND_USER=hexnil_backend
MYSQL_BACKEND_PASSWORD=backend_password_here

# AI analysis user (read-only on raw tables, write-only to derived tables)
MYSQL_AI_USER=hexnil_ai
MYSQL_AI_PASSWORD=your_secure_password_here

# ============================================================================
# FASTAPI SERVER CONFIGURATION
# ============================================================================

FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_WORKERS=4

# ============================================================================
# AI ANALYSIS CONFIGURATION
# ============================================================================

# How often to run analysis (in minutes)
AI_ANALYSIS_INTERVAL=15

# Thermal thresholds (Celsius)
THERMAL_WARNING_TEMP=35.0
THERMAL_CRITICAL_TEMP=45.0

# Battery drain thresholds (% per hour)
EXCESSIVE_DRAIN_RATE=10.0
IDLE_DRAIN_WARNING=1.0

# Degradation thresholds
RAPID_DEGRADATION_THRESHOLD=5.0
